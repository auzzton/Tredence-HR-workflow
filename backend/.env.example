# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# asyncpg connection string used by the app at runtime
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tredence

# Non-pooled URL for Alembic migrations (required by Neon; falls back to DATABASE_URL).
# Leave empty for local development — it will use DATABASE_URL automatically.
ALEMBIC_DATABASE_URL=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Environment: dev | test | prod
ENV=dev

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
